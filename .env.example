# === ROBLOX OPEN CLOUD ===
# Buat di: https://create.roblox.com/dashboard/credentials
# Scope yang dibutuhkan: Assets - Write (dan Read kalau mau cek status)
ROBLOX_API_KEY=isi_api_key_roblox_disini

# ID Creator (User ID atau Group ID kamu di Roblox)
ROBLOX_CREATOR_TYPE=User
# Ganti jadi "Group" kalau upload atas nama group
ROBLOX_CREATOR_ID=isi_userid_atau_groupid_disini

# === AUDD.IO (deteksi/pre-check musik berhak cipta) ===
# Daftar & ambil API token gratis di: https://dashboard.audd.io/
AUDD_API_TOKEN=isi_token_audd_disini

PORT=3000
